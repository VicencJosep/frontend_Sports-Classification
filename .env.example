# Copy to .env.local and adjust. All variables are optional.

# Which MatchService implementation the UI uses: "api" (FastAPI backend, default) or "mock" (fixtures in public/mock).
VITE_DATA_SOURCE=api

# Where the browser sends API requests. Unset = same origin: Vite proxies /api to the backend
# (VITE_PROXY_TARGET, default http://127.0.0.1:8100), so remote development only needs port 5173 forwarded.
# VITE_API_BASE_URL=http://localhost:8100
# VITE_PROXY_TARGET=http://127.0.0.1:8100
